# Totali backend. Copy to .env and set these in your host's secret store. Never commit real values.

PORT=8787

# SQLite file the data persists to. Leave unset only for local experiments (data is lost on restart).
TOTALI_DATA_FILE=./.totali-data/db.sqlite

# Bearer token that can create companies and record what the bank tells Totali. Treat it like a bank credential.
TOTALI_ADMIN_TOKEN=

# 32 random bytes, base64. Encrypts SSNs, bank account numbers and ACH files at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes them unrecoverable: back it up separately from the data file.
TOTALI_DATA_KEY=
# To rotate: put the new key in TOTALI_DATA_KEY, the old one(s) here (comma-separated), run
# POST /v1/ops/rotate-data-key, then remove the old key.
# TOTALI_DATA_KEY_PREVIOUS=

# ---- Stripe. Two jobs: Totali's own subscription ($20 every 3 months, a hosted Checkout page and a billing portal) and
# bank linking (Financial Connections). Stripe moves no payroll money. Start with a TEST key.
# A live key is refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1

# ---- Totali-sent payments only (a company in totali_ach mode). The default, employer-bank mode, uses each employer's own bank and needs none of these.
# Your bank assigns these when it approves you as an originator.
TOTALI_ODFI_ROUTING=
TOTALI_ODFI_NAME=
TOTALI_ORIGIN_ID=
TOTALI_ORIGINATOR_COMPANY_ID=
# What appears as the originator on statements (default TOTALI PAYROLL).
# TOTALI_ORIGINATOR_NAME=

# outbox (default): write ACH files to a directory for pickup by whatever carries them to the bank.
# sandbox: a simulated bank for development. Refused when NODE_ENV=production.
# column: send each payment through Column's API (works for employers at any bank). Needs the three COLUMN_ values below.
TOTALI_ACH_MODE=outbox
# COLUMN_API_KEY=test_...           # test_ is Column's free sandbox; live_ moves real money
# COLUMN_BANK_ACCOUNT_ID=bacc_...   # the Column account Totali sends from
# COLUMN_ROUTING_NUMBER=...         # that account's routing number, shown in the Column dashboard
TOTALI_ACH_OUTBOX=./.totali-data/ach-outbox

# Banking days after the employer's debit settles before employees are paid. Covers returns. Default 2.
# TOTALI_ACH_HOLD_BANKING_DAYS=2
# Banking days from handing over a file to its effective date. 1 is standard ACH; 0 is same-day ACH if your bank offers it.
# TOTALI_ACH_FUNDING_LEAD_DAYS=1
# TOTALI_ACH_CREDIT_LEAD_DAYS=1
# Treat a debit as settled on its effective date without the bank confirming. Off by default: do not turn on unless your bank's reporting makes it safe.
# TOTALI_TRUST_SETTLEMENT_DATE=1
# Pay employees automatically once a run is funded and the hold has passed.
# TOTALI_AUTO_DISBURSE=1

# Requests per minute per client address (0 turns it off), and whether to trust X-Forwarded-For (only behind a proxy you control).
# TOTALI_RATE_LIMIT_PER_MIN=600
# TOTALI_TRUST_PROXY=1

# Python for the MasteryTax filings layer (3.10+). Defaults to python3.
# TOTALI_PYTHON=python3

# ---- accounts, email and billing (the web app) ----
# Verification codes and invites go out through Resend. Without a key they stay in an in-memory outbox (never sent).
# RESEND_API_KEY=re_...
# A bare address is sent as "Totali <address>". Verify the domain in Resend first, or only the Resend account owner receives mail.
# RESEND_FROM=verify@yourdomain.com
# Public address of the site. https:// makes the session cookie Secure and decides where email links point.
# PUBLIC_BASE_URL=https://app.yourdomain.com
# Shows verification codes at /v1/dev/outbox when there is no Resend key. Ignored when NODE_ENV=production.
# TOTALI_DEV=1
# Used by the bank-linking form (Financial Connections). The secret key is the same STRIPE_SECRET_KEY.
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sign in with Google. Create an OAuth client (Web application) in Google Cloud and add
# {PUBLIC_BASE_URL}/v1/auth/google/callback as an authorized redirect URI. Without both values the button is hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Where "Message us" in Help is delivered (through Resend). Default hello@omnia.tax.
# Sign in with Clover (reads staff, hours and tips). Needs Totali's own Clover app, approved by Clover (see
# docs/PARTNER_APPLICATIONS.md). Set the app's Site URL / redirect to {PUBLIC_BASE_URL}/v1/pos/clover/callback.
# Without both values the owner is asked to paste a token instead, which most restaurants can't get.
# CLOVER_APP_ID=
# CLOVER_APP_SECRET=
# Sign in with Square. Register an application in the Square Developer Dashboard (self-serve) and set its OAuth
# redirect URL to {PUBLIC_BASE_URL}/v1/pos/square/callback.
# SQUARE_APP_ID=
# SQUARE_APP_SECRET=
# SUPPORT_EMAIL=hello@omnia.tax
# Verifies Stripe's webhook signature. In the Stripe dashboard (Developers, Webhooks) add the endpoint
# {PUBLIC_BASE_URL}/v1/stripe/webhook with the events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed.
# STRIPE_WEBHOOK_SECRET=whsec_...
# The price is built in code ($20 every 3 months). To use a price you made in the dashboard instead, put its id here.
# STRIPE_PRICE_ID=
# Approving payroll needs a live subscription whenever Stripe is set up. Set 0 to stop asking, or list company ids to waive.
# TOTALI_BILLING_REQUIRED=0
# TOTALI_BILLING_EXEMPT=cmp_...,cmp_...
