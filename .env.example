# Totali backend. Copy to .env and set these in your host's secret store. Never commit real values.

PORT=8787

# JSON file the data persists to. Leave unset only for local experiments (data is lost on restart).
TOTALI_DATA_FILE=./.totali-data/db.json

# Bearer token that can create companies.
TOTALI_ADMIN_TOKEN=

# 32 random bytes, base64. Encrypts SSNs at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored SSNs unrecoverable. Back it up separately from the data file.
TOTALI_DATA_KEY=

# Stripe. Start with a TEST key (sk_test_...). A live key is refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
# Signing secret(s) of the endpoint(s) pointing at /v1/webhooks/stripe. A regular endpoint and a Connect endpoint each have their own: separate them with a comma.
STRIPE_WEBHOOK_SECRET=
# STRIPE_ALLOW_LIVE=1
# 'recipient' puts employee connected accounts on Stripe's recipient service agreement. Confirm with Stripe it is available to you first.
# STRIPE_CONNECT_SERVICE_AGREEMENT=full

# Hours to hold collected employer money before paying employees (ACH debits can be returned for a short time). Default 48.
TOTALI_ACH_RETURN_HOLD_HOURS=48
# Pay employees automatically once a run is funded and the hold has passed.
# TOTALI_AUTO_DISBURSE=1

# Python for the MasteryTax filings layer (3.10+). Defaults to python3.
# TOTALI_PYTHON=python3
