# Totali backend. Copy to .env and set these in your host's secret store. Never commit real values.

PORT=8787

# SQLite file the data persists to. Leave unset only for local experiments (data is lost on restart).
TOTALI_DATA_FILE=./.totali-data/db.sqlite

# Bearer token that can create companies and record what the bank tells Totali. Treat it like a bank credential.
TOTALI_ADMIN_TOKEN=

# 32 random bytes, base64. Encrypts SSNs, bank account numbers and ACH files at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes them unrecoverable: back it up separately from the data file.
TOTALI_DATA_KEY=
# To rotate: put the new key in TOTALI_DATA_KEY, the old one(s) here (comma-separated), run
# POST /v1/ops/rotate-data-key, then remove the old key.
# TOTALI_DATA_KEY_PREVIOUS=

# ---- Stripe: bank linking only (Financial Connections). Stripe moves no money. Start with a TEST key.
# A live key is refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1

# ---- Totali-sent payments only (a company in totali_ach mode). The default, employer-bank mode, uses each employer's own bank and needs none of these.
# Your bank assigns these when it approves you as an originator.
TOTALI_ODFI_ROUTING=
TOTALI_ODFI_NAME=
TOTALI_ORIGIN_ID=
TOTALI_ORIGINATOR_COMPANY_ID=
# What appears as the originator on statements (default TOTALI PAYROLL).
# TOTALI_ORIGINATOR_NAME=

# outbox (default): write ACH files to a directory for pickup by whatever carries them to the bank.
# sandbox: a simulated bank for development. Refused when NODE_ENV=production.
# column: send each payment through Column's API (works for employers at any bank). Needs the three COLUMN_ values below.
TOTALI_ACH_MODE=outbox
# COLUMN_API_KEY=test_...           # test_ is Column's free sandbox; live_ moves real money
# COLUMN_BANK_ACCOUNT_ID=bacc_...   # the Column account Totali sends from
# COLUMN_ROUTING_NUMBER=...         # that account's routing number, shown in the Column dashboard
TOTALI_ACH_OUTBOX=./.totali-data/ach-outbox

# Banking days after the employer's debit settles before employees are paid. Covers returns. Default 2.
# TOTALI_ACH_HOLD_BANKING_DAYS=2
# Banking days from handing over a file to its effective date. 1 is standard ACH; 0 is same-day ACH if your bank offers it.
# TOTALI_ACH_FUNDING_LEAD_DAYS=1
# TOTALI_ACH_CREDIT_LEAD_DAYS=1
# Treat a debit as settled on its effective date without the bank confirming. Off by default: do not turn on unless your bank's reporting makes it safe.
# TOTALI_TRUST_SETTLEMENT_DATE=1
# Pay employees automatically once a run is funded and the hold has passed.
# TOTALI_AUTO_DISBURSE=1

# Requests per minute per client address (0 turns it off), and whether to trust X-Forwarded-For (only behind a proxy you control).
# TOTALI_RATE_LIMIT_PER_MIN=600
# TOTALI_TRUST_PROXY=1

# Python for the MasteryTax filings layer (3.10+). Defaults to python3.
# TOTALI_PYTHON=python3
